{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "banner",
  "position": {
    "x": 0,
    "y": 0,
    "width": 1600,
    "height": 118,
    "z": 0,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "textbox",
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "background": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "color": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#10243B'"
                    }
                  }
                }
              }
            },
            "transparency": {
              "expr": {
                "Literal": {
                  "Value": "0D"
                }
              }
            }
          }
        }
      ]
    },
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt",
                      "fontFamily": "Segoe UI",
                      "color": "#1A3048",
                      "bold": false
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
}