        "lineageTag": "c893b3f0-b047-4ab3-8662-c09480f67d25",
        "measures": [
          {
            "name": "ME Raw Signals",
            "description": "Reporting measure; does not expose the strategy logic.",
            "displayFolder": "Report Metrics",
            "expression": "COUNTROWS('FactSignals')",
            "formatString": "#,##0",
            "lineageTag": "88459d24-3497-43b2-bdc5-bb6bc7056896"
          },
          {
            "name": "ME Repeat Review",
            "description": "Reporting measure; does not expose the strategy logic.",
            "displayFolder": "Report Metrics",
            "expression": "SUM('FactSignals'[DuplicateReview])",
            "formatString": "#,##0",
            "lineageTag": "d337eb26-7546-402f-b290-7bdcc6373b8f"
          },
          {
            "name": "ME Incomplete Logs",
            "description": "Reporting measure; does not expose the strategy logic.",
            "displayFolder": "Report Metrics",
            "expression": "CALCULATE(COUNTROWS('FactSignals'),'FactSignals'[DataStatus]=\"Incomplete core fields\")",
            "formatString": "#,##0",
            "lineageTag": "4af1db7d-6e69-420c-8b8a-57f56f5b27c0"
          },
          {
            "name": "ME Raw Without Hit",
            "description": "Reporting measure; does not expose the strategy logic.",
            "displayFolder": "Report Metrics",
            "expression": "CALCULATE(COUNTROWS('FactSignals'),'FactSignals'[OutcomeCategory]=\"Expired / no hit\")",
            "formatString": "#,##0",
            "lineageTag": "b9ec3f2c-8c77-4cb9-b21f-2e90aaccecbd"
          },
          {
            "name": "ME Raw Recorded",
            "expression": "CALCULATE([ME Raw Signals],'FactSignals'[DataStatus]=\"Recorded target / SL hit\")",
            "formatString": "#,##0",
            "isHidden": true,
            "lineageTag": "dc56f6e4-b72d-4ad4-b5c9-bf7cd2a81cab"
          },
          {
            "name": "ME Raw Expired",
            "expression": "CALCULATE([ME Raw Signals],'FactSignals'[DataStatus]=\"Expired / no recorded hit\")",
            "formatString": "#,##0",
            "isHidden": true,
            "lineageTag": "248ed0ad-8f77-4a33-8ef6-5a9c591243eb"
          },
          {
            "name": "ME Raw Missing Outcome",
            "expression": "CALCULATE([ME Raw Signals],'FactSignals'[DataStatus]=\"Outcome missing\")",
            "formatString": "#,##0",
            "isHidden": true,
            "lineageTag": "a9c6c600-2fa6-4fcc-87e3-791e22621654"
          }
        ],
        "partitions": [
          {
            "name": "FactSignals",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\",\", Columns=10, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"Month\", type text}, {\"Sector\", type text}, {\"Grade\", type text}, {\"OptionSide\", type text}, {\"PatternLabel\", type text}, {\"OIConfirmation\", type text}, {\"SignalFamily\", type text}, {\"OutcomeCategory\", type text}, {\"DuplicateReview\", Int64.Type}, {\"DataStatus\", type text}}, \"en-US\"),",
                "    WithGradeSort = Table.AddColumn(Typed, \"GradeSort\", each if [Grade] = \"A+\" then 1 else if [Grade] = \"A\" then 2 else if [Grade] = \"B\" then 3 else if [Grade] = \"C\" then 4 else if [Grade] = \"D\" then 5 else 99, Int64.Type),",
                "    WithMonthSort = Table.AddColumn(WithGradeSort, \"MonthSort\", each if [Month] = \"September 2026\" then 1 else if [Month] = \"October 2026\" then 2 else 99, Int64.Type)",
                "in",
                "    WithMonthSort"
              ],
              "type": "m"
            }
          }
        ]
      },
