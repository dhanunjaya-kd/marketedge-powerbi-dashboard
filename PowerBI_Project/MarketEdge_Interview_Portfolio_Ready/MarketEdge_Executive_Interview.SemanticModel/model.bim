        "lineageTag": "da7c1438-04d9-407f-b9ee-6e36bfd83f8f",
        "measures": [
          {
            "name": "ME Trades",
            "description": "Reporting measure; does not expose the strategy logic.",
            "displayFolder": "Report Metrics",
            "expression": "COUNTROWS('FactBacktest')",
            "formatString": "#,##0",
            "lineageTag": "217bbb60-b310-47d4-8293-14acf7db3d50"
          },
          {
            "name": "ME Wins",
            "description": "Reporting measure; does not expose the strategy logic.",
            "displayFolder": "Report Metrics",
            "expression": "SUM('FactBacktest'[IsWin])",
            "formatString": "#,##0",
            "lineageTag": "b6d9f809-047f-4a78-b869-b586c042e432"
          },
          {
            "name": "ME Losses",
            "description": "Reporting measure; does not expose the strategy logic.",
            "displayFolder": "Report Metrics",
            "expression": "[ME Trades] - [ME Wins]",
            "formatString": "#,##0",
            "lineageTag": "87632828-c346-4790-856c-ff02ff1000bc"
          },
          {
            "name": "ME Win Rate",
            "description": "Reporting measure; does not expose the strategy logic.",
            "displayFolder": "Report Metrics",
            "expression": "DIVIDE([ME Wins],[ME Trades])",
            "formatString": "0.0%",
            "lineageTag": "6ce3bb27-0ad0-4138-b62e-d9589b49942f"
          },
          {
            "name": "ME Gross PnL",
            "description": "Reporting measure; does not expose the strategy logic.",
            "displayFolder": "Report Metrics",
            "expression": "SUM('FactBacktest'[GrossPnL])",
            "formatString": "₹#,##0;(₹#,##0)",
            "lineageTag": "78631104-c1a6-428c-8a83-4198a92ce036"
          },
          {
            "name": "ME Profit Factor",
            "description": "Reporting measure; does not expose the strategy logic.",
            "displayFolder": "Report Metrics",
            "expression": "DIVIDE(CALCULATE([ME Gross PnL],'FactBacktest'[GrossPnL]>0),ABS(CALCULATE([ME Gross PnL],'FactBacktest'[GrossPnL]<0)))",
            "formatString": "0.00",
            "lineageTag": "e4e72e00-6fd2-404a-90ce-48ac5ebfc439"
          },
          {
            "name": "ME Avg R",
            "description": "Reporting measure; does not expose the strategy logic.",
            "displayFolder": "Report Metrics",
            "expression": "AVERAGE('FactBacktest'[RMultiple])",
            "formatString": "0.00\"R\"",
            "lineageTag": "bbef8b79-05e8-4bf9-8c7c-6ca6c56fca6a"
          },
          {
            "name": "ME Stop Rate",
            "description": "Reporting measure; does not expose the strategy logic.",
            "displayFolder": "Report Metrics",
            "expression": "DIVIDE(CALCULATE([ME Trades],'FactBacktest'[ExitType]=\"SL\"),[ME Trades])",
            "formatString": "0.0%",
            "lineageTag": "560e48f4-854c-4625-8bc8-b794f9ff0c11"
          },
          {
            "name": "ME Target 3 Rate",
            "description": "Reporting measure; does not expose the strategy logic.",
            "displayFolder": "Report Metrics",
            "expression": "DIVIDE(CALCULATE([ME Trades],'FactBacktest'[ExitType]=\"Target 3\"),[ME Trades])",
            "formatString": "0.0%",
            "lineageTag": "3ad1bbe7-8aa9-4a21-8b21-2fafc4cdce0f"
          },
          {
            "name": "ME Average Gross",
            "description": "Reporting measure; does not expose the strategy logic.",
            "displayFolder": "Report Metrics",
            "expression": "DIVIDE([ME Gross PnL],[ME Trades])",
            "formatString": "₹#,##0;(₹#,##0)",
            "lineageTag": "01ded8f1-db54-4445-a3f6-e7f46ebf4705"
          },
          {
            "name": "ME Cumulative Gross",
            "description": "Reporting measure; does not expose the strategy logic.",
            "displayFolder": "Report Metrics",
            "expression": "VAR D=MAX('FactBacktest'[ExitDate]) RETURN CALCULATE([ME Gross PnL],FILTER(ALLSELECTED('FactBacktest'[ExitDate]),'FactBacktest'[ExitDate]<=D))",
            "formatString": "₹#,##0;(₹#,##0)",
            "lineageTag": "e096760d-9a66-472c-aa96-7899aa387250"
          },
          {
            "name": "ME Verified Net PnL",
            "description": "Blank unless every filtered trade has independently verified fees/net outcome.",
            "displayFolder": "Report Metrics",
            "expression": "VAR Missing=COUNTROWS(FILTER('FactBacktest',ISBLANK('FactBacktest'[Charges])||ISBLANK('FactBacktest'[NetPnL]))) RETURN IF(Missing>0,BLANK(),SUM('FactBacktest'[NetPnL]))",
            "formatString": "₹#,##0;(₹#,##0)",
            "lineageTag": "2ec8933a-42fb-4d47-bb1b-d047c967128e"
          },
          {
            "name": "ME Win Gross",
            "description": "Reporting measure; does not expose the strategy logic.",
            "displayFolder": "Report Metrics",
            "expression": "CALCULATE([ME Gross PnL],'FactBacktest'[GrossPnL]>0)",
            "formatString": "₹#,##0;(₹#,##0)",
            "lineageTag": "001b4b96-d951-4c0e-9a0f-e84360e78e31"
          },
          {
            "name": "ME Loss Gross",
            "description": "Reporting measure; does not expose the strategy logic.",
            "displayFolder": "Report Metrics",
            "expression": "CALCULATE([ME Gross PnL],'FactBacktest'[GrossPnL]<0)",
            "formatString": "₹#,##0;(₹#,##0)",
            "lineageTag": "b74456c3-8201-4055-a9f4-d953c14f5917"
          },
          {
            "name": "ME Avg Winning R",
            "description": "Reporting measure; does not expose the strategy logic.",
            "displayFolder": "Report Metrics",
            "expression": "CALCULATE([ME Avg R],'FactBacktest'[IsWin]=1)",
            "formatString": "0.00\"R\"",
            "lineageTag": "d86d7651-605f-4156-adb4-794f6faebd08"
          },
          {
            "name": "ME Avg Losing R",
            "description": "Reporting measure; does not expose the strategy logic.",
            "displayFolder": "Report Metrics",
            "expression": "CALCULATE([ME Avg R],'FactBacktest'[IsWin]=0)",
            "formatString": "0.00\"R\"",
            "lineageTag": "14b0a032-8251-4f28-890d-aafb0e1c8211"
          },
          {
            "name": "ME Selected Sectors",
            "description": "Reporting measure; does not expose the strategy logic.",
            "displayFolder": "Report Metrics",
            "expression": "DISTINCTCOUNT('FactBacktest'[Sector])",
            "formatString": "#,##0",
            "lineageTag": "b095d127-f8e3-4fff-8d82-57be438fb4a7"
          },
          {
            "name": "ME Gross PnL Label",
            "description": "Indian lakh-format executive KPI. Numeric gross P&L remains separate for arithmetic and chart axes.",
            "displayFolder": "Report Metrics",
            "expression": "VAR X = [ME Gross PnL] RETURN IF(ISBLANK(X),BLANK(),VAR V = ABS(X) RETURN IF(X < 0,\"−\",\"\") & \"₹\" & IF(V >= 100000, FORMAT(V/100000,\"0.00\") & \" L\", FORMAT(V,\"#,##0\")))",
            "lineageTag": "707b8f28-e459-4544-9b0f-e1486810fee7"
          },
          {
            "name": "ME Sample Size Note",
            "description": "Displays cohort size and flags filtered groups with fewer than 20 reported trades.",
            "displayFolder": "Report Metrics",
            "expression": "VAR N=[ME Trades] RETURN IF(ISBLANK(N),BLANK(),\"n=\" & FORMAT(N,\"#,##0\") & IF(N < 20, \" • LOW SAMPLE\", \"\"))",
            "lineageTag": "a8e007d6-f31e-49fe-a454-d27f91183ace"
          },
          {
            "name": "ME Sniper Only Trades",
            "description": "Comparison count for Sniper (non-Tape); respects all other applied filters.",
            "displayFolder": "Report Metrics",
            "expression": "CALCULATE([ME Trades],'FactBacktest'[SignalFamily]=\"Sniper (non-Tape)\")",
            "formatString": "#,##0",
            "lineageTag": "cd3f404f-10d6-472c-87ec-08df338f18de"
          },
          {
            "name": "ME Tape Trades",
            "description": "Comparison count for Tape Momentum; respects other applied filters.",
            "displayFolder": "Report Metrics",
            "expression": "CALCULATE([ME Trades],'FactBacktest'[SignalFamily]=\"Tape Momentum\")",
            "formatString": "#,##0",
            "lineageTag": "2b4f29e3-a2f0-426e-a76a-caa78974a466"
          },
          {
            "name": "ME Matrix Cell Color",
            "description": "Visual-only conditional color. Amber means n below 20; other shades reflect recorded win rate.",
            "displayFolder": "Report Metrics",
            "expression": "VAR N=[ME Trades] VAR W=[ME Win Rate] RETURN IF(ISBLANK(W),\"#FFFFFF\",IF(N<20,\"#FFF0D7\",SWITCH(TRUE(),W>=0.75,\"#C5E9E0\",W>=0.60,\"#E7F6F2\",W>=0.45,\"#E9F2FA\",\"#F9D7D9\")))",
            "lineageTag": "835d3ee6-3d26-4211-8d13-67dea13c9c68"
          },
          {
            "name": "ME Gross Per Trade",
            "description": "Gross backtest P&L divided by filtered historical trade count.",
            "displayFolder": "Report Metrics",
            "expression": "DIVIDE([ME Gross PnL],[ME Trades])",
            "formatString": "₹#,##0;(₹#,##0)",
            "lineageTag": "aa5f2875-5f79-4c34-84dc-0fe4837b79a6"
          },
          {
            "name": "ME End of Day Drawdown",
            "description": "End-of-day gross drawdown from the highest prior end-of-day gross equity value; excludes intra-day price fluctuations.",
            "displayFolder": "Report Metrics",
            "expression": [
              "VAR DayCutoff=MAX('FactBacktest'[ExitDate])",
              "VAR DayEquity=[ME Cumulative Gross]",
              "VAR PeakToDate=MAXX(FILTER(ALLSELECTED('FactBacktest'[ExitDate]),'FactBacktest'[ExitDate]<=DayCutoff),CALCULATE([ME Cumulative Gross]))",
              "RETURN IF(ISBLANK(DayCutoff),BLANK(),MIN(0,DayEquity-MAX(0,PeakToDate)))"
            ],
            "formatString": "₹#,##0;(₹#,##0)",
            "lineageTag": "15f2df07-a521-4eb1-ab76-b62e5dc439bc"
          },
          {
            "name": "ME Win Loss Ratio",
            "description": "Mean winning R divided by absolute mean losing R.",
            "displayFolder": "Report Metrics",
            "expression": "DIVIDE([ME Avg Winning R],ABS([ME Avg Losing R]))",
            "formatString": "0.00\"x\"",
            "lineageTag": "53b3f9eb-4d84-4e0d-a315-65717757643b"
          },
          {
            "name": "ME Quality Flag",
            "description": "Cohort sample-size warning; not a probability estimate.",
            "displayFolder": "Report Metrics",
            "expression": "VAR N=[ME Trades] RETURN IF(ISBLANK(N),BLANK(),IF(N<20,\"LOW SAMPLE • n=\" & FORMAT(N,\"#,##0\"),\"n=\" & FORMAT(N,\"#,##0\")))",
            "lineageTag": "0e52e88b-5fd8-456f-9b0a-b0c15800c04a"
          },
          {
            "name": "ME Win Rate Label",
            "description": "Win rate with sample-size context.",
            "displayFolder": "Report Metrics",
            "expression": "IF(ISBLANK([ME Win Rate]),BLANK(),FORMAT([ME Win Rate],\"0.0%\") & \"  |  n=\" & FORMAT([ME Trades],\"#,##0\"))",
            "lineageTag": "fbb54403-d71f-40f8-a4a0-f440b0f827b5"
          },
          {
            "name": "ME Historical Scope",
            "description": "Dynamic scope summary; historical backtest, gross only.",
            "displayFolder": "Report Metrics",
            "expression": "FORMAT([ME Trades],\"#,##0\") & \" RESULTS  •  \" & FORMAT([ME Win Rate],\"0.0%\") & \" WIN  •  GROSS ONLY\"",
            "lineageTag": "3e9214a9-077d-41b2-b3dd-6b87d31b902a"
          },
          {
            "name": "ME Gross Per Trade Exact Label",
            "description": "Whole-rupee gross amount per reported backtest outcome; displayed without automatic K/M abbreviations.",
            "displayFolder": "Report Metrics",
            "expression": "VAR X=[ME Gross Per Trade] RETURN IF(ISBLANK(X),BLANK(), IF(X<0,\"−₹\",\"₹\") & FORMAT(ABS(X),\"#,##0\"))",
            "lineageTag": "3896cb8d-2158-4e83-991a-e08a35b3bce4"
          },
          {
            "name": "ME Sector Grade Evidence",
            "description": "For the sector × grade matrix, each cell shows win rate and the corresponding number of reported observations.",
            "displayFolder": "Report Metrics",
            "expression": "VAR N=[ME Trades] VAR W=[ME Win Rate] RETURN IF(N=0 || ISBLANK(W),BLANK(),FORMAT(W,\"0%\") & \"  |  \" & FORMAT(N,\"#,##0\"))",
            "lineageTag": "3e4e116d-d77a-4c6e-b8e3-9a1c733916c5"
          },
          {
            "name": "ME Top Sector Rank",
            "expression": "RANKX(ALLSELECTED('FactBacktest'[Sector]),[ME Gross PnL],,DESC,Dense)",
            "isHidden": true,
            "lineageTag": "3089cbcd-1f10-4bf3-a6b1-b4048785b958"
          },
          {
            "name": "ME Top 5 Sector Gross",
            "expression": "IF([ME Trades]>0 && [ME Top Sector Rank]<=5,[ME Gross PnL],BLANK())",
            "formatString": "₹#,##0;−₹#,##0",
            "isHidden": true,
            "lineageTag": "ff26e201-2985-41f1-bd2e-aa69f4ac25e9"
          },
          {
            "name": "ME Cohort Summary",
            "expression": [
              "VAR N=[ME Trades]",
              "RETURN IF(N=0,\"NO RESULTS IN SELECTION\",\"n=\" & FORMAT(N,\"#,##0\") & \"  |  WIN \" & FORMAT([ME Win Rate],\"0.0%\") & \"  |  PF \" & IF(ISBLANK([ME Profit Factor]),\"n/a\",FORMAT([ME Profit Factor],\"0.00\")))"
            ],
            "isHidden": true,
            "lineageTag": "c049a755-72aa-4de7-9304-da77683f2587"
          },
          {
            "name": "ME Sample Context",
            "expression": [
              "VAR N=[ME Trades]",
              "RETURN SWITCH(TRUE(),N=0,\"NO DATA IN THIS FILTER\",N<20,\"LOW SAMPLE • n < 20\",N<50,\"LIMITED SAMPLE • TWO MONTHS\",\"HISTORICAL • TWO MONTHS ONLY\")"
            ],
            "isHidden": true,
            "lineageTag": "83804e21-4aab-40d8-9209-a37d6b00ab81"
          },
          {
            "name": "ME Gross Summary",
            "expression": [
              "VAR N=[ME Trades]",
              "RETURN IF(N=0,\"NO RESULTS\",[ME Gross PnL Label] & \" GROSS  |  \" & FORMAT([ME Avg R],\"0.00\") & \"R AVG\")"
            ],
            "isHidden": true,
            "lineageTag": "c729ce80-1884-4f1e-aa07-de8224b8a3f9"
          },
          {
            "name": "ME Exit Summary",
            "expression": [
              "VAR N=[ME Trades]",
              "RETURN IF(N=0,\"NO RESULTS\",\"STOP \" & FORMAT([ME Stop Rate],\"0.0%\") & \"  |  T3 \" & FORMAT([ME Target 3 Rate],\"0.0%\"))"
            ],
            "isHidden": true,
            "lineageTag": "6ef4b818-f5f5-4a57-a00c-937dc001591a"
          },
          {
            "name": "ME Cohort Title",
            "expression": [
              "VAR N=[ME Trades]",
              "RETURN IF(N=0,\"No matches\",\"COHORT: \" & FORMAT(N,\"#,##0\") & \" reported results\")"
            ],
            "isHidden": true,
            "lineageTag": "3fd6722e-f347-40b5-8670-708a39e59beb"
          },
          {
            "name": "ME Grade Bubble Sample Warning",
            "expression": [
              "VAR N=[ME Trades]",
              "RETURN IF(N=0,\"NO DATA\",IF(N<20,\"LOW N — DESCRIPTIVE ONLY\",\"n=\" & FORMAT(N,\"#,##0\") & \" • GROSS ONLY\"))"
            ],
            "isHidden": true,
            "lineageTag": "ab5ccbcd-c375-4fb0-b3a7-11a450a92a07"
          },
          {
            "name": "ME Readout Brief",
            "description": "Short filter-responsive summary for compact executive note; no strategy entry logic.",
            "displayFolder": "Report Metrics",
            "expression": "VAR N=[ME Trades] RETURN IF(N=0,\"NO RESULTS\",FORMAT(N,\"#,##0\") & \"  •  \" & FORMAT([ME Win Rate],\"0.0%\") & \" WINS\")",
            "lineageTag": "eedb8952-3bb8-4693-b405-809067d6520f"
          }
        ],
        "partitions": [
          {
            "name": "FactBacktest",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\",\", Columns=19, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"Month\", type text}, {\"ExitDate\", type date}, {\"WeekStart\", type date}, {\"Sector\", type text}, {\"Grade\", type text}, {\"PatternLabel\", type text}, {\"OIConfirmation\", type text}, {\"OptionSide\", type text}, {\"SignalFamily\", type text}, {\"ExitType\", type text}, {\"EntrySession\", type text}, {\"Overnight\", type logical}, {\"GrossPnL\", type number}, {\"RMultiple\", type number}, {\"IsWin\", Int64.Type}, {\"HoldingMinutes\", type number}, {\"SectorMatch\", type text}, {\"NetPnL\", type number}, {\"Charges\", type number}}, \"en-US\"),",
                "    WithGradeSort = Table.AddColumn(Typed, \"GradeSort\", each if [Grade] = \"A+\" then 1 else if [Grade] = \"A\" then 2 else if [Grade] = \"B\" then 3 else if [Grade] = \"C\" then 4 else if [Grade] = \"D\" then 5 else 99, Int64.Type),",
                "    WithMonthSort = Table.AddColumn(WithGradeSort, \"MonthSort\", each if [Month] = \"September 2026\" then 1 else if [Month] = \"October 2026\" then 2 else 99, Int64.Type)",
                "in",
                "    WithMonthSort"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "FactSignals",
        "columns": [
          {
            "name": "Month",
            "dataType": "string",
            "lineageTag": "be5ba9ae-848c-4bae-bf0b-3200778f89fc",
            "sortByColumn": "MonthSort",
            "sourceColumn": "Month",
            "summarizeBy": "none"
          },
          {
            "name": "Sector",
            "dataType": "string",
            "lineageTag": "75bc1692-092b-483e-b02c-a9f942e71f0c",
            "sourceColumn": "Sector",
            "summarizeBy": "none"
          },
          {
            "name": "Grade",
            "dataType": "string",
            "lineageTag": "18046ca2-5e11-4f20-8000-ed6845db178d",
            "sortByColumn": "GradeSort",
            "sourceColumn": "Grade",
            "summarizeBy": "none"
          },
          {
            "name": "OptionSide",
            "dataType": "string",
            "lineageTag": "01cc7213-4c46-4f4e-9bd1-aa12603c9663",
            "sourceColumn": "OptionSide",
            "summarizeBy": "none"
          },
          {
            "name": "PatternLabel",
