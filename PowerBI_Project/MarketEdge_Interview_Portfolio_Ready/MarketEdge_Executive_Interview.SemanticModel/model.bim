              "expression": "Calendar(Date(Year(MIN('FactBacktest'[WeekStart])), 1, 1), Date(Year(MAX('FactBacktest'[WeekStart])), 12, 31))",
              "type": "calculated"
            }
          }
        ],
        "showAsVariationsOnly": true
      }
    ]
  }
}